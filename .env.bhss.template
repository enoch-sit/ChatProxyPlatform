# BHSS-Specific Environment Configuration
# Copy to .env.bhss and fill in actual values

# Service URLs (use BHSS domain from diagnose-bhss-state.ps1)
AUTH_SERVICE_URL=http://ai01.bhss.edu.hk:3000
ACCOUNT_SERVICE_URL=http://ai01.bhss.edu.hk:3001
FLOWISE_PROXY_URL=http://ai01.bhss.edu.hk:8000
BRIDGE_UI_URL=http://ai01.bhss.edu.hk:3082

# Batch Operations
BATCH_ENV=bhss
ADMIN_PASSWORD=admin@admin

# Email Configuration (AWS SES for BHSS)
EMAIL_SERVICE=ses
AWS_SES_REGION=us-east-1
AWS_SES_FROM_EMAIL=noreply@bhss.edu.hk

# Database (if using hosted MongoDB/PostgreSQL)
MONGO_URI=mongodb://mongo-host:27017/auth_db
POSTGRES_URI=postgresql://user:password@postgres-host:5432/accounting_db

# Logging
LOG_DIR=logs
LOG_LEVEL=info
