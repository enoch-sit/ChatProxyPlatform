system_check_report_*.txt

# ============================================
# User-Specific Data
# ============================================
# User CSV backups (keep template, ignore copies)
auth-service/quickCreateAdminPy/users.csv.backup*
auth-service/quickCreateAdminPy/users_backup_*.csv

# Certificates (except placeholders)
nginx/certs/*.pem
nginx/certs/*.key
nginx/certs/*.pfx
!nginx/certs/README.md

